    "weatherInfo.gustDiff.danger.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudden wind changes create high risk of attitude loss and collision"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
