    "weatherInfo.windSpeed.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wind speed is the most important factor for drone flight.\n\nThe currently selected %@ drone can resist wind speeds up to %.1fm/s. However, for safety, it is recommended to avoid flying in wind speeds above %.1fm/s.\n\nLighter drones are more affected by wind, so caution is needed even at lower wind speeds."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풍속은 드론 비행에 가장 중요한 요소입니다.\n\n현재 선택된 %@ 드론은 최대 %.1fm/s의 풍속까지 저항할 수 있습니다. 그러나 안전을 위해 %.1fm/s 이상의 풍속에서는 비행을 자제하는 것이 좋습니다.\n\n드론 무게가 가벼울수록 바람의 영향을 더 많이 받으므로, 더 낮은 풍속에서도 주의가 필요합니다."
          }
        }
      }
    },
