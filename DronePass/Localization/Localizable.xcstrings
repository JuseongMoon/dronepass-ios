    "weatherInfo.gustDiff.danger.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop or postpone flight immediately. If emergency landing needed, descend very slowly"
          }
        },
