          }
        }
      }
    },
    "weatherInfo.gustDiff.danger.range" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%.1f m/s or more"
          }
        },
