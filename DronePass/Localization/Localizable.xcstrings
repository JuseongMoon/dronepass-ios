    "account.switch.warning.message" : {
      "comment" : "Account switch data loss message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %d modified shape(s) not saved to the cloud. Continuing will permanently delete them with no way to recover. Log in again with the previous account to keep them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드에 저장되지 않은 %d개의 수정된 도형이 있습니다. 계속하면 영구 삭제되어 복구할 수 없습니다. 기존 계정으로 다시 로그인하면 보존됩니다."
          }
        }
      }
    },
    "account.switch.warning.title" : {
